{
  "name": "rabaed-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Rabaed marketing site.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/with-database.mjs next dev",
    "build": "node scripts/migrate-production.mjs && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "playwright test",
    "baselines:capture": "node scripts/capture-baselines.mjs",
    "baselines:verify": "node scripts/capture-baselines.mjs --verify",
    "fonts:sync": "node scripts/sync-fonts.mjs",
    "mocks:export": "node scripts/with-database.mjs \"next build && node scripts/export-screen-mocks.mjs\"",
    "cms:migrate": "payload migrate",
    "cms:migration": "node scripts/with-database.mjs payload migrate:create",
    "cms:generate": "node scripts/with-database.mjs \"payload generate:importmap && payload generate:types\"",
    "cms:create-editor": "payload run scripts/create-editor.ts"
  },
  "devDependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "18.4.0-beta.17",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.56.1",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/storage-s3": "3.89.0",
    "@payloadcms/translations": "3.89.0",
    "@payloadcms/ui": "3.89.0",
    "graphql": "^16.14.2",
    "gsap": "^3.15.0",
    "next": "^16.3.5",
    "nodemailer": "^10.0.10",
    "payload": "3.89.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4"
  }
}
